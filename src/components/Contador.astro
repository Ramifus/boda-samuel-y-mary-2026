---
// ContadorRegresivo.astro
---

<!-- ═══════════════════════════════════════════════════════════ --><!-- ⏰ COMPONENTE CONTADOR REGRESIVO                            --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="py-8 px-6">
    <div class="max-w-md md:max-w-md lg:max-w-xl xl:max-w-2xl mx-auto">
        <!-- CUENTA REGRESIVA - ESTILO COMPACTO -->
        <div class="relative" id="cuenta-regresiva">
            <!-- Etiqueta "Faltan" arriba centrada -->
            <div
                class="absolute -top-3 left-1/2 transform -translate-x-1/2 z-10"
                id="texto-faltan"
            >
                <div
                    class="bg-[#9C7A2E] text-white px-6 py-1.5 rounded-full shadow-md"
                    id="pastilla-faltan"
                >
                    <p class="font-sans text-sm md:text-base tracking-wide">
                        Faltan
                    </p>
                </div>
            </div>

            <!-- Contenedor principal con borde -->
            <div
                class="bg-white border-2 border-[#9C7A2E] rounded-2xl pt-6 pb-4 md:py-10 px-6 shadow-sm"
            >
                <div class="grid grid-cols-4 gap-3">
                    <!-- DÍAS -->
                    <div class="text-center unidad-contador">
                        <p
                            id="dias"
                            class="numero-contador font-sans text-3xl md:text-4xl text-[#0F3D2E] font-light mb-1"
                        >
                            00
                        </p>
                        <p
                            class="etiqueta-contador font-sans text-[10px] md:text-base text-[#9C7A2E] uppercase tracking-wide"
                        >
                            Días
                        </p>
                    </div>

                    <!-- HORAS -->
                    <div class="text-center unidad-contador">
                        <p
                            id="horas"
                            class="numero-contador font-sans text-3xl md:text-4xl text-[#0F3D2E] font-light mb-1"
                        >
                            00
                        </p>
                        <p
                            class="etiqueta-contador font-sans text-[10px] md:text-base text-[#9C7A2E] uppercase tracking-wide"
                        >
                            Hrs
                        </p>
                    </div>

                    <!-- MINUTOS -->
                    <div class="text-center unidad-contador">
                        <p
                            id="minutos"
                            class="numero-contador font-sans text-3xl md:text-4xl text-[#0F3D2E] font-light mb-1"
                        >
                            00
                        </p>
                        <p
                            class="etiqueta-contador font-sans text-[10px] md:text-base text-[#9C7A2E] uppercase tracking-wide"
                        >
                            Mins
                        </p>
                    </div>

                    <!-- SEGUNDOS -->
                    <div class="text-center unidad-contador">
                        <p
                            id="segundos"
                            class="numero-contador font-sans text-3xl md:text-4xl text-[#0F3D2E] font-light mb-1"
                        >
                            00
                        </p>
                        <p
                            class="etiqueta-contador font-sans text-[10px] md:text-base text-[#9C7A2E] uppercase tracking-wide"
                        >
                            Segs
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP Y CUENTA REGRESIVA                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // ═══ CONFIGURACIÓN DE LA FECHA ═══
    const FECHA_EVENTO = {
        año: 2026,
        mes: 12,
        dia: 19,
        hora: 15,
        minuto: 0,
    };

    const initContador = () => {
        console.log("⏰ Iniciando contador regresivo...");

        // ═══ ESTADO INICIAL ═══
        const estadoInicial = () => {
            gsap.set("#cuenta-regresiva", { opacity: 0, scale: 0.94 });
            gsap.set("#pastilla-faltan", { opacity: 0, y: -18, scale: 0.8 });
            gsap.set(".numero-contador", { opacity: 0, y: 22, filter: "blur(6px)" });
            gsap.set(".etiqueta-contador", { opacity: 0, y: 10, letterSpacing: "0.35em" });
        };
        estadoInicial();

        // ═══ ANIMACIÓN DE ENTRADA (texto por texto) ═══
        const entrada = gsap
            .timeline({ paused: true })
            // 1️⃣ La tarjeta aparece suave
            .to("#cuenta-regresiva", {
                opacity: 1,
                scale: 1,
                duration: 0.9,
                ease: "power2.out",
            })
            // 2️⃣ "Faltan" baja y se posa
            .to(
                "#pastilla-faltan",
                { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: "back.out(1.6)" },
                0.35,
            )
            // 3️⃣ Los números aparecen uno por uno, desenfocados a nítidos
            .to(
                ".numero-contador",
                {
                    opacity: 1,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 1,
                    ease: "power3.out",
                    stagger: 0.18,
                },
                0.6,
            )
            // 4️⃣ Las etiquetas (Días, Hrs...) se acomodan después de cada número
            .to(
                ".etiqueta-contador",
                {
                    opacity: 1,
                    y: 0,
                    letterSpacing: "0.025em",
                    duration: 0.9,
                    ease: "power2.out",
                    stagger: 0.18,
                },
                0.9,
            );

        // Se repite cada vez que se baja hasta el contador
        let salida: gsap.core.Tween | null = null;
        ScrollTrigger.create({
            trigger: "#cuenta-regresiva",
            start: "top 85%",
            onEnter: () => {
                salida?.kill();
                estadoInicial();
                entrada.restart();
            },
            onLeaveBack: () => {
                entrada.pause();
                salida = gsap.to("#cuenta-regresiva", {
                    opacity: 0,
                    duration: 0.4,
                    ease: "power2.in",
                    onComplete: estadoInicial,
                });
            },
        });

        // ═══ CUENTA REGRESIVA ═══
        const fechaBoda = new Date(
            FECHA_EVENTO.año,
            FECHA_EVENTO.mes - 1,
            FECHA_EVENTO.dia,
            FECHA_EVENTO.hora,
            FECHA_EVENTO.minuto,
            0,
        ).getTime();

        console.log("📅 Fecha del evento:", new Date(fechaBoda));

        function actualizarCuentaRegresiva() {
            const ahora = new Date().getTime();
            const diferencia = fechaBoda - ahora;

            console.log("⏱️ Diferencia en ms:", diferencia);

            if (diferencia > 0) {
                const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
                const horas = Math.floor(
                    (diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                );
                const minutos = Math.floor(
                    (diferencia % (1000 * 60 * 60)) / (1000 * 60),
                );
                const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

                const diasEl = document.getElementById("dias");
                const horasEl = document.getElementById("horas");
                const minutosEl = document.getElementById("minutos");
                const segundosEl = document.getElementById("segundos");

                if (diasEl)
                    diasEl.textContent = dias.toString().padStart(2, "0");
                if (horasEl)
                    horasEl.textContent = horas.toString().padStart(2, "0");
                if (minutosEl)
                    minutosEl.textContent = minutos.toString().padStart(2, "0");
                if (segundosEl)
                    segundosEl.textContent = segundos
                        .toString()
                        .padStart(2, "0");
            } else {
                // Cuando llegue la fecha
                const diasEl = document.getElementById("dias");
                const horasEl = document.getElementById("horas");
                const minutosEl = document.getElementById("minutos");
                const segundosEl = document.getElementById("segundos");

                if (diasEl) diasEl.textContent = "00";
                if (horasEl) horasEl.textContent = "00";
                if (minutosEl) minutosEl.textContent = "00";
                if (segundosEl) segundosEl.textContent = "00";
            }
        }

        // Actualizar cada segundo
        actualizarCuentaRegresiva();
        setInterval(actualizarCuentaRegresiva, 1000);

        console.log("⏰✨ Contador regresivo activado!");
    };

    // Ejecutar cuando el DOM esté listo
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initContador);
    } else {
        initContador();
    }

    // También ejecutar en Astro page load (para navegación entre páginas)
    document.addEventListener("astro:page-load", initContador);
</script>
