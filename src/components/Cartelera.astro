---
// Cartelera.astro - Cartelera musical estilo afiche de gala
const grupos = [
    { nombre: "Tomy Laser", imagen: "/imagenes/tomylaser.webp" },
    { nombre: "Agrupación Tornado", imagen: "/imagenes/agrupaciontornado.webp" },
    { nombre: "Cristian José", imagen: "/imagenes/cristianjose.webp" },
    { nombre: "Florida Vásquez", imagen: "/imagenes/floritavasquez.webp" },
];
---

<section class="relative w-full py-14 px-5 overflow-hidden" id="seccion-cartelera">
    <!-- Resplandor dorado de fondo -->
    <div class="cartelera-resplandor" aria-hidden="true"></div>

    <!-- ═══ TÍTULO ═══ -->
    <div class="relative text-center mb-12" id="cartelera-titulo">
        <div class="flex items-center justify-center gap-3 mb-3 cartelera-sub">
            <span class="h-px w-10 md:w-16 bg-gradient-to-r from-transparent to-[#9C7A2E]"></span>
            <span class="flex items-center gap-2 text-[#9C7A2E] text-xs md:text-sm tracking-[0.35em] uppercase font-semibold">
                <span class="punto-vivo"></span>
                Música en vivo
            </span>
            <span class="h-px w-10 md:w-16 bg-gradient-to-l from-transparent to-[#9C7A2E]"></span>
        </div>

        <h2 class="text-[#9C7A2E] tracking-[0.2em] uppercase text-2xl md:text-3xl lg:text-4xl font-semibold leading-snug cartelera-h2">
            Cartelera Musical
        </h2>

        <p class="font-charm text-[#0F3D2E] text-xl md:text-2xl mt-2 cartelera-sub">
            Una noche para celebrar el amor bailando
        </p>

        <div class="flex items-center justify-center gap-3 mt-5 cartelera-sub">
            <span class="h-px w-16 bg-[#9C7A2E]/50"></span>
            <span class="text-[#9C7A2E] text-lg">✦</span>
            <span class="h-px w-16 bg-[#9C7A2E]/50"></span>
        </div>
    </div>

    <!-- ═══ GRUPOS ═══ -->
    <div class="relative max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-x-10 md:gap-y-16">
        {
            grupos.map((g, i) => (
                <article class="grupo-card relative">
                    <!-- Foto con marco dorado doble -->
                    <div class="grupo-marco relative">
                        <span class="esquina esquina-tl" aria-hidden="true" />
                        <span class="esquina esquina-tr" aria-hidden="true" />
                        <span class="esquina esquina-bl" aria-hidden="true" />
                        <span class="esquina esquina-br" aria-hidden="true" />

                        <div class="grupo-foto relative overflow-hidden">
                            <img
                                src={g.imagen}
                                alt={g.nombre}
                                loading="lazy"
                                class="grupo-img w-full h-full object-cover"
                            />
                            <!-- Degradado inferior para dar profundidad -->
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0F3D2E]/45 via-transparent to-transparent" />
                            <!-- Destello dorado que cruza la foto -->
                            <div class="grupo-destello" aria-hidden="true" />

                            <!-- Sello EN VIVO -->
                            <div class="absolute top-3 left-3 flex items-center gap-1.5 bg-white/90 rounded-full px-3 py-1 shadow-md">
                                <span class="punto-vivo" />
                                <span class="text-[10px] md:text-xs text-[#0F3D2E] font-bold tracking-[0.2em] uppercase">
                                    En vivo
                                </span>
                            </div>

                            <!-- Número -->
                            <div class="absolute bottom-3 right-4 text-white/90 text-xs md:text-sm tracking-[0.3em] font-semibold">
                                N° {String(i + 1).padStart(2, "0")}
                            </div>
                        </div>

                        <!-- Nombre del grupo, dentro de la tarjeta -->
                        <div class="text-center pt-4 pb-2 px-2 grupo-texto">
                            <h3 class="font-cormorant text-[#0F3D2E] uppercase tracking-[0.25em] text-xl md:text-2xl font-normal leading-snug">
                                {g.nombre}
                            </h3>
                            <div class="flex items-center justify-center gap-3 mt-2">
                                <span class="grupo-linea h-px w-14 bg-gradient-to-r from-transparent to-[#9C7A2E]" />
                                <span class="text-[#9C7A2E] text-sm">♪</span>
                                <span class="grupo-linea h-px w-14 bg-gradient-to-l from-transparent to-[#9C7A2E]" />
                            </div>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>

    <!-- Cierre -->
    <div class="relative flex items-center justify-center gap-4 mt-14" id="credito-cartelera">
        <div style="height:1px; flex:1; max-width:90px; background: linear-gradient(to right, transparent, #9C7A2E);"></div>
        <span class="font-charm text-[#9C7A2E] text-lg md:text-xl">¡Te esperamos en la pista!</span>
        <div style="height:1px; flex:1; max-width:90px; background: linear-gradient(to left, transparent, #9C7A2E);"></div>
    </div>
</section>

<style>
    .cartelera-resplandor {
        position: absolute;
        inset: 10% -20%;
        background:
            radial-gradient(ellipse at 50% 20%, rgba(156, 122, 46, 0.12), transparent 60%),
            radial-gradient(ellipse at 50% 80%, rgba(15, 61, 46, 0.06), transparent 60%);
        pointer-events: none;
    }

    /* Marco dorado doble */
    .grupo-marco {
        padding: 10px;
        border: 1px solid rgba(156, 122, 46, 0.55);
        border-radius: 6px;
        background: #ffffff;
        box-shadow:
            0 18px 40px -18px rgba(15, 61, 46, 0.45),
            0 0 0 4px #ffffff,
            0 0 0 5px rgba(156, 122, 46, 0.35);
    }

    .grupo-foto {
        aspect-ratio: 4 / 3.4;
        border-radius: 3px;
    }

    .grupo-img {
        transform-origin: center;
    }

    /* Esquinas ornamentales */
    .esquina {
        position: absolute;
        width: 22px;
        height: 22px;
        border-color: #9C7A2E;
        border-style: solid;
        z-index: 5;
        pointer-events: none;
    }
    .esquina-tl { top: -6px; left: -6px; border-width: 2px 0 0 2px; }
    .esquina-tr { top: -6px; right: -6px; border-width: 2px 2px 0 0; }
    .esquina-bl { bottom: -6px; left: -6px; border-width: 0 0 2px 2px; }
    .esquina-br { bottom: -6px; right: -6px; border-width: 0 2px 2px 0; }

    /* Destello dorado */
    .grupo-destello {
        position: absolute;
        top: 0;
        left: -60%;
        width: 45%;
        height: 100%;
        background: linear-gradient(
            100deg,
            transparent,
            rgba(255, 236, 170, 0.45),
            transparent
        );
        transform: skewX(-18deg);
        pointer-events: none;
    }

    /* Punto rojo "en vivo" que late */
    .punto-vivo {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 9999px;
        background: #c0392b;
        box-shadow: 0 0 0 0 rgba(192, 57, 43, 0.6);
        animation: latido-vivo 1.6s ease-out infinite;
    }

    @keyframes latido-vivo {
        0% { box-shadow: 0 0 0 0 rgba(192, 57, 43, 0.6); }
        70% { box-shadow: 0 0 0 7px rgba(192, 57, 43, 0); }
        100% { box-shadow: 0 0 0 0 rgba(192, 57, 43, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .punto-vivo { animation: none; }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Chispas doradas que suben desde la tarjeta
    function crearBrasa(card: HTMLElement) {
        const p = document.createElement("div");
        const size = Math.random() * 4 + 4;
        const esRedonda = Math.random() > 0.4;
        const startX = Math.random() * 86 + 7;
        const totalY = Math.random() * 80 + 60;
        const swayX = (Math.random() - 0.5) * 40;
        const duracion = Math.random() * 1.8 + 2.2;

        p.style.cssText = `
            position: absolute;
            width: ${size}px;
            height: ${esRedonda ? size : size * 1.6}px;
            background: radial-gradient(circle at 40% 40%, #F0D97A, #C9A84C, #9C7A2E);
            border-radius: ${esRedonda ? "50%" : "40% 60% 50% 50%"};
            pointer-events: none;
            z-index: 30;
            left: ${startX}%;
            bottom: 35%;
            opacity: 0;
            box-shadow: 0 0 ${size + 4}px rgba(230,190,80,0.85);
            transform: rotate(${Math.random() * 360}deg);
        `;
        card.appendChild(p);

        gsap.timeline({ onComplete: () => p.remove() })
            .to(p, { opacity: Math.random() * 0.4 + 0.55, duration: 0.4, ease: "power1.out" })
            .to(p, { y: -totalY * 0.5, x: swayX * 0.5, rotation: `+=${Math.random() * 120 - 60}`, duration: duracion * 0.5, ease: "none" }, 0)
            .to(p, { y: -totalY, x: swayX, opacity: 0, rotation: `+=${Math.random() * 120 - 60}`, duration: duracion * 0.5, ease: "power1.in" });
    }

    function iniciarChispas(card: HTMLElement) {
        if (card.dataset.chispas) return;
        card.dataset.chispas = "1";
        const emitir = () => {
            crearBrasa(card);
            setTimeout(emitir, Math.random() * 500 + 400);
        };
        setTimeout(emitir, Math.random() * 1500);
    }

    const initCartelera = () => {
        const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ═══ TÍTULO (se repite cada vez que se baja) ═══
        gsap.set("#cartelera-titulo .cartelera-sub", { opacity: 0, y: 15 });
        gsap.set("#cartelera-titulo .cartelera-h2", { opacity: 0, scale: 0.85, y: 20 });
        const tlTitulo = gsap
            .timeline({ paused: true })
            .to("#cartelera-titulo .cartelera-h2", { opacity: 1, scale: 1, y: 0, duration: 1.4, ease: "power3.out" })
            .to("#cartelera-titulo .cartelera-sub", { opacity: 1, y: 0, duration: 0.9, ease: "power2.out", stagger: 0.15 }, 0.3);

        ScrollTrigger.create({
            trigger: "#cartelera-titulo",
            start: "top 80%",
            onEnter: () => tlTitulo.timeScale(1).restart(),
            onLeaveBack: () => tlTitulo.timeScale(2.5).reverse(),
        });

        // ═══ CADA GRUPO ENTRA EN SECUENCIA, ALTERNANDO LADOS ═══
        document.querySelectorAll<HTMLElement>(".grupo-card").forEach((card, i) => {
            const marco = card.querySelector(".grupo-marco");
            const img = card.querySelector(".grupo-img");
            const texto = card.querySelector(".grupo-texto");
            const lineas = card.querySelectorAll(".grupo-linea");
            const destello = card.querySelector(".grupo-destello");
            const lado = i % 2 === 0 ? -60 : 60;
            // En computadora van de a dos: el de la derecha entra un poco después
            const retraso = window.innerWidth >= 768 && i % 2 === 1 ? 0.35 : 0;
            let efectos: gsap.core.Tween[] = [];

            gsap.set(marco, { opacity: 0, x: lado, y: 30 });
            gsap.set(img, { scale: 1.35, opacity: 0 });
            gsap.set(texto, { opacity: 0, y: 25 });
            gsap.set(lineas, { scaleX: 0 });

            const tl = gsap
                .timeline({ paused: true, delay: retraso })
                .to(marco, { opacity: 1, x: 0, y: 0, duration: 1.1, ease: "power3.out" })
                .to(img, { opacity: 1, duration: 1, ease: "power1.out" }, 0.15)
                .to(img, { scale: 1, duration: 2, ease: "power2.out" }, 0.15)
                .to(texto, { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, 0.8)
                .to(lineas, { scaleX: 1, duration: 0.9, ease: "power2.out" }, 1.1)
                .call(() => {
                    if (reducido) return;
                    iniciarChispas(card);
                    efectos = [
                        // Destello dorado que cruza la foto cada tanto
                        gsap.fromTo(
                            destello,
                            { left: "-60%" },
                            { left: "130%", duration: 1.4, ease: "power2.inOut", repeat: -1, repeatDelay: 3.5 },
                        ),
                        // Acercamiento muy lento de la foto
                        gsap.to(img, { scale: 1.06, duration: 8, ease: "sine.inOut", repeat: -1, yoyo: true }),
                    ];
                });

            const detenerEfectos = () => {
                efectos.forEach((t) => t.kill());
                efectos = [];
                gsap.set(destello, { left: "-60%" });
            };

            ScrollTrigger.create({
                trigger: card,
                start: "top 80%",
                onEnter: () => {
                    detenerEfectos();
                    tl.timeScale(1).restart(true);
                },
                onLeaveBack: () => {
                    detenerEfectos();
                    tl.timeScale(2.5).reverse();
                },
            });
        });

        // ═══ CIERRE ═══
        gsap.set("#credito-cartelera", { opacity: 0, y: 15 });
        ScrollTrigger.create({
            trigger: "#credito-cartelera",
            start: "top 92%",
            onEnter: () => gsap.to("#credito-cartelera", { opacity: 1, y: 0, duration: 1, ease: "power2.out" }),
            onLeaveBack: () => gsap.to("#credito-cartelera", { opacity: 0, y: 15, duration: 0.4 }),
        });
    };

    document.addEventListener("DOMContentLoaded", initCartelera);
</script>
